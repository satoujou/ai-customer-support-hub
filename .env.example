# Application
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-5.6-luna

# PostgreSQL: POSTGRES_PASSWORD and DATABASE_URL must use the same password.
POSTGRES_PASSWORD=replace_with_a_long_random_database_password
DATABASE_URL=postgresql://supporthub:replace_with_a_long_random_database_password@db:5432/supporthub

# First tenant
COMPANY_ID=company_001
COMPANY_NAME=Demo Company
PLATFORM_ADMIN_USER=admin

# One-time bootstrap only. Use 12+ characters, run bootstrap, then remove this line from .env.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_long_unique_admin_password
